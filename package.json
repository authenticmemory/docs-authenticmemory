{
  "name": "docs-authenticmemory",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown-sourced developer manual, built to standalone static HTML.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node --watch-path=docs --watch-path=tools --watch-path=manual.config.json tools/build.mjs",
    "prepare": "git config core.hooksPath tools/hooks || true"
  },
  "devDependencies": {
    "lunr": "^2.3.9",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0"
  }
}
